{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/botiverse/vcase/schema/vcase-manifest.schema.json",
  "title": "vcase manifest (vcase/1)",
  "description": "vcase.manifest.json as written by every adapter (vcase-core Manifest.kt, @vcase/react). Produced by a scan, never written by hand. Unknown keys are an error, as in vcase-core (ignoreUnknownKeys = false).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "project", "defaults", "cases"],
  "properties": {
    "schema": { "const": "vcase/1" },
    "project": { "type": "string", "minLength": 1 },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["theme", "viewport", "locale", "pointer"],
      "properties": {
        "theme": { "$ref": "#/definitions/nonEmptyStrings" },
        "viewport": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "w", "h", "density"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "w": { "type": "integer", "exclusiveMinimum": 0 },
              "h": { "type": "integer", "exclusiveMinimum": 0 },
              "density": { "type": "number", "exclusiveMinimum": 0 },
              "optIn": { "type": "boolean", "description": "Omitted while false: only cases that name the viewport use it." },
              "sizeClass": { "type": "string", "minLength": 1, "description": "Layout mode the host pins (compact, wide). Not an axis; never in file names." }
            }
          }
        },
        "locale": { "$ref": "#/definitions/nonEmptyStrings" },
        "pointer": { "type": "array", "minItems": 1, "items": { "enum": ["touch", "fine"] } },
        "fontScale": { "type": "array", "minItems": 1, "items": { "type": "number", "exclusiveMinimum": 0 }, "description": "Omitted while it is [1.0]." }
      }
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source"],
        "properties": {
          "id": { "$ref": "#/definitions/id" },
          "kind": { "enum": ["component", "screen"] },
          "source": { "type": "string", "description": "path/to/file:line of the declaration, relative to the repository root." },
          "fixture": { "type": ["string", "null"] },
          "axes": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "theme": { "$ref": "#/definitions/nonEmptyStrings" },
              "viewport": { "$ref": "#/definitions/nonEmptyStrings" },
              "locale": { "$ref": "#/definitions/nonEmptyStrings" },
              "pointer": { "type": "array", "minItems": 1, "items": { "enum": ["touch", "fine"] } },
              "fontScale": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$" } }
            }
          },
          "parity": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*:[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$" } },
          "divergences": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["with", "kind", "why"],
              "properties": {
                "with": { "type": "string", "minLength": 1 },
                "region": { "type": "string" },
                "kind": { "type": "string" },
                "why": { "type": "string", "minLength": 1 },
                "decidedBy": { "type": "string" },
                "ref": { "type": "string" },
                "expires": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}" }
              }
            }
          },
          "formerly": { "type": "array", "items": { "$ref": "#/definitions/id" }, "description": "Omitted while empty." },
          "needsDevice": { "type": "boolean", "description": "Omitted while false." },
          "capture": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "description": "Omitted while the case uses the host's capture settings.",
            "properties": {
              "maxWidth": { "type": "integer", "exclusiveMinimum": 0 },
              "maxHeight": { "type": "integer", "exclusiveMinimum": 0 },
              "settleFrames": { "type": "integer", "minimum": 0 },
              "frameIntervalMs": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$" },
    "nonEmptyStrings": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  }
}
