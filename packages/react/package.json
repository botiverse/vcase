{
  "name": "@vcase/react",
  "version": "0.1.4",
  "description": "vcase adapter for React: scan *.cases.tsx / stories / example files into a vcase manifest, capture them with Playwright, verify against goldens.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/botiverse/vcase.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/botiverse/vcase/tree/main/packages/react#readme",
  "bugs": {
    "url": "https://github.com/botiverse/vcase/issues"
  },
  "keywords": [
    "visual-testing",
    "screenshot",
    "playwright",
    "react",
    "storybook",
    "snapshot"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "vcase-react": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./schema.json": "./schema/vcase-manifest.schema.json"
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist",
    "schema"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "playwright": "^1.65.1",
    "pngjs": "^7.0.0",
    "tinyglobby": "^0.2.17",
    "typescript": "~5.9.3"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/pngjs": "^6.0.5",
    "ajv": "^8.20.0",
    "vitest": "^5.1.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
